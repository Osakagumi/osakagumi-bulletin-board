{
  "rules": {
    ".read": false,
    ".write": false,

    "presence": {
      ".read": "auth != null",
      "$key": {
        ".write": "auth != null && newData.child('ownerEmail').val() === auth.token.email",
        ".validate": "newData.hasChildren(['online', 'ownerEmail'])"
      }
    }
  }
}
