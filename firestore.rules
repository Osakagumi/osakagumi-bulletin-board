rules_version = '2';

// 使い方:
// Firebaseコンソール > Firestore Database > ルール タブに、このファイルの中身を
// そのまま貼り付けて「公開」してください。
//
// システム管理者の登録方法:
// Firestoreの「admins」コレクションに、システム管理者にしたい人のメールアドレスを
// ドキュメントIDとしてドキュメントを1つ作成してください（中身は空でOK）。
// 例: コレクション admins > ドキュメントID: hine@osakagumi.co.jp

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.token.email));
    }

    function isPoster() {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/announcement_posters/$(request.auth.token.email)));
    }

    function isWhereaboutsEditor() {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/whereabouts_editors/$(request.auth.token.email)));
    }

    function isEquipmentManager() {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/equipment_managers/$(request.auth.token.email)));
    }
    function isContractEditor() {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/contract_editors/$(request.auth.token.email)));
    }

    function isCalendarEditor() {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/calendar_editors/$(request.auth.token.email)));
    }

    function isSafetySender() {
      return isAdmin() ||
        (isSignedIn() &&
          exists(/databases/$(database)/documents/safety_senders/$(request.auth.token.email)));
    }

    // システム管理者一覧: ログインしていれば読めるが、書き込みはシステム管理者のみ
    match /admins/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 利用停止（実質的な「削除」）対象ユーザーの一覧: 本人が自分の状態を確認するために読める必要がある。書き込みはシステム管理者のみ。
    match /blocked_users/{email} {
      allow read: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow write: if isAdmin();
    }

    // お知らせ投稿権限一覧: ログインしていれば読めるが、書き込みはシステム管理者のみ
    match /announcement_posters/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 行き先ボード「他者設定権限」一覧: ログインしていれば読めるが、書き込みはシステム管理者のみ
    match /whereabouts_editors/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 所属（部署）マスタ: 全員が読める。追加・編集・削除はシステム管理者のみ。
    match /departments/{deptId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // アプリ全体の設定（行き先ビューの列数など）: 全員が読める。書き込みはシステム管理者のみ。
    match /app_settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (isAdmin() || isContractEditor() || isPoster() || isSafetySender());
    }

    // タブの並び順・初期表示タブ・一般画面での既定の表示タブなど、システム全体の既定値。
    // 全員が読めるが、書き込みはシステム管理者のみ。
    match /system_tab_defaults/{screenId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 行き先の事前設定（次の営業日用の下書き・初期状態テンプレート・自動反映済み日付の記録）
    // 全員が読める。書き込みは行き先の他者設定権限者・システム管理者のみ。
    match /wb_presets/{docId} {
      allow read: if isSignedIn();
      allow write: if isWhereaboutsEditor();
    }

    // カレンダー編集権限一覧: 全員が読める。書き込みはシステム管理者のみ。
    match /calendar_editors/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 年間休日カレンダー（日付ごとの休日ON/OFF・名称）: 全員が読める。編集はカレンダー編集権限者・システム管理者のみ。
    match /calendar_days/{dateId} {
      allow read: if isSignedIn();
      allow write: if isCalendarEditor();
    }

    // 公開済みカレンダーのスナップショット。編集中でも、社員には最後に公開された内容が見え続けるようにするためのもの。
    match /calendar_days_published/{dateId} {
      allow read: if isSignedIn();
      allow write: if isCalendarEditor();
    }

    // 年間休日カレンダーの年度一覧（最大3年度分の管理用）: 全員が読める。編集はカレンダー編集権限者・システム管理者のみ。
    match /calendar_years/{yearId} {
      allow read: if isSignedIn();
      allow write: if isCalendarEditor();
    }

    // お知らせの既読管理（本人の既読状態のみ、本人だけが読み書きできる）
    match /notice_reads/{email} {
      allow read, write: if isSignedIn() && request.auth.token.email == email;
    }

    // 個人ごとの画面設定（アカウントに紐づけて保存する好み設定）: 本人のみ読み書き可能。
    match /user_prefs/{email} {
      allow read, write: if isSignedIn() && request.auth.token.email == email;
    }

    // 行き先ステータスマスタ（在席・外出・現場・休みなど）: 全員が読める。管理はシステム管理者のみ。
    match /wb_statuses/{statusId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 設備カテゴリ（会議室・業務共用車輌・測量機器・ドローンなど）: 全員が読める。管理はシステム管理者のみ。
    match /equipment_categories/{categoryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 社員名簿（行き先ボード兼用）: ログインすると自動で自分の行が作られる。
    // 読み取りは全員。新規作成は本人のみ（なりすまし登録防止）。
    // 更新（氏名・所属・状態など）は本人 / システム管理者 / 行き先の他者設定権限者。削除はシステム管理者のみ。
    match /employees/{email} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (request.auth.token.email == email || isAdmin());
      allow update: if isSignedIn() &&
        (request.auth.token.email == email || isAdmin() || isWhereaboutsEditor());
      allow delete: if isAdmin();
    }

    // 設備管理者一覧（点検日の編集・貸出状態の管理ができる人）: 全員が読める。書き込みはシステム管理者のみ。
    match /equipment_managers/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 契約（入札関係情報）の編集権限者一覧: 全員が読める。書き込みはシステム管理者のみ。
    match /contract_editors/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 入札の対応部門などのアプリ全体設定: 全員が読める。書き込みはシステム管理者 or 契約編集権限者のみ。
    // 契約（入札関係情報）: 全員が読める（公開）。作成・更新・削除はシステム管理者 or 契約編集権限者のみ。
    match /contracts/{contractId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isContractEditor();
    }

    // 業務情報（Googleドライブ上のファイルを一般画面にピル切り替えで表示する）: 全員が読める。管理はシステム管理者のみ。
    match /business_info_items/{itemId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ダイレクトメッセージ（1対1）: 送信者・受信者本人のみ読み書き可能。1日経過後に自動削除される。
    match /direct_messages/{messageId} {
      allow read: if isSignedIn() &&
        (resource.data.senderEmail == request.auth.token.email || resource.data.recipientEmail == request.auth.token.email);
      allow create: if isSignedIn() && request.resource.data.senderEmail == request.auth.token.email;
      allow update: if isSignedIn() &&
        (resource.data.senderEmail == request.auth.token.email || resource.data.recipientEmail == request.auth.token.email);
      allow delete: if isSignedIn() &&
        (resource.data.senderEmail == request.auth.token.email || resource.data.recipientEmail == request.auth.token.email);
    }

    // 設備マスタ: ログインしていれば読める。
    // 追加・削除・基本情報の編集はシステム管理者のみ。
    // 状態変更（在庫中・貸出中・点検中・故障中）は、在庫中からの操作は誰でも、
    // それ以外は設備管理者、または現在の借用者本人が可能。
    match /equipment/{equipmentId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin() || isEquipmentManager();
      allow update: if isSignedIn() &&
        (isAdmin() || isEquipmentManager() ||
          !("status" in resource.data) ||
          resource.data.status == "in_stock" ||
          resource.data.holderEmail == request.auth.token.email);
    }

    // 予約: ログインしていれば読める。
    // 作成は本人のuserIdでのみ可能。更新・削除は本人またはシステム管理者のみ可能。
    match /reservations/{reservationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // お知らせ: 全員が読める。投稿は投稿権限者のみ。削除・編集は本人 or システム管理者。
    match /announcements/{postId} {
      allow read: if isSignedIn();
      allow create: if isPoster() &&
        request.resource.data.authorEmail == request.auth.token.email;
      allow update: if isSignedIn() &&
        (resource.data.authorEmail == request.auth.token.email || isAdmin() ||
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readByAt"]));
      allow delete: if isSignedIn() &&
        (resource.data.authorEmail == request.auth.token.email || isAdmin());
    }

    // 安否確認キャンペーン: 全員が読める。作成・編集・終了はシステム管理者、または安否確認発信権限者のみ。
    match /safety_campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow write: if isSafetySender();
    }

    // 安否確認発信権限一覧: ログインしていれば読めるが、書き込みはシステム管理者のみ
    match /safety_senders/{email} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // 安否確認への回答: 全員が読める（誰が回答済みかシステム管理者が把握するため）。
    // 書き込みは本人のuserIdでのみ可能。
    match /safety_responses/{responseId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if isSafetySender();
    }

    // 敷鉄板の種類マスタ（6m・3mなど、総数・単価）: 全員が読める。
    // 追加・編集・削除はシステム管理者、または設備管理者のみ。
    match /steel_plate_types/{typeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isEquipmentManager();
    }

    // 敷鉄板の貸出・返却の記録: 全員が読める。
    // 作成は本人のメールアドレスでのみ可能。更新・削除は本人 / システム管理者 / 設備管理者のみ。
    match /steel_plate_transactions/{txId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        request.resource.data.createdByEmail == request.auth.token.email;
      allow update, delete: if isSignedIn() &&
        (resource.data.createdByEmail == request.auth.token.email || isAdmin() || isEquipmentManager());
    }
  }
}
